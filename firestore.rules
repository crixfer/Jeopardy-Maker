rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Games collection: teachers create and browse educational Jeopardy boards
    match /games/{gameId} {
      allow get, list: if isValidId(gameId);

      allow create: if isValidId(gameId)
        && incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 100
        && incoming().categories is list && incoming().categories.size() <= 20;

      allow update: if isValidId(gameId)
        && incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 100
        && incoming().categories is list && incoming().categories.size() <= 20;

      allow delete: if isValidId(gameId);
    }

    // Live Game Sessions: real-time multiplayer board, teams, and buzzer sync
    match /game_sessions/{sessionId} {
      allow get: if isValidId(sessionId);
      allow list: if true;

      allow create: if isValidId(sessionId)
        && incoming().pin is string && incoming().pin.size() <= 10
        && incoming().status is string && incoming().status.size() <= 30;

      allow update: if isValidId(sessionId)
        && incoming().status is string && incoming().status.size() <= 30;

      allow delete: if isValidId(sessionId);
    }

    // Leaderboards: multi-session cumulative points and school records
    match /leaderboards/{leaderboardId} {
      allow get, list: if isValidId(leaderboardId);

      allow create: if isValidId(leaderboardId)
        && incoming().teamName is string && incoming().teamName.size() > 0 && incoming().teamName.size() <= 60
        && incoming().totalScore is number
        && incoming().gamesPlayed is number;

      allow update: if isValidId(leaderboardId)
        && incoming().teamName is string && incoming().teamName.size() > 0 && incoming().teamName.size() <= 60
        && incoming().totalScore is number
        && incoming().gamesPlayed is number;

      allow delete: if false;
    }

    // Connection testing doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
